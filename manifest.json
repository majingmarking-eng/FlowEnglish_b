{
  "manifest_version": 3,
  "name": "FlowEnglish",
  "version": "0.1.0",
  "description": "B 站英文课程学习助手：缓存优先、原生字幕优先、按需 ASR，双语字幕 / 生词本 / 填空练习 / 笔记，全部数据保存在浏览器本地。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "FlowEnglish",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.bytedance.com/*",
    "https://*.volces.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/video/*"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "js": [
        "src/lib/core.js",
        "src/lib/storage.js",
        "src/lib/subtitle.js",
        "src/lib/exporter.js",
        "src/content/capture.js",
        "src/content/panel.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.bilibili.com/video/*"
      ],
      "js": [
        "src/content/page-probe.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
